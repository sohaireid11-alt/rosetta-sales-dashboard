{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Google Calendar secrets are set with `wrangler secret put`, never committed:
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, optional GOOGLE_TOKEN_ENCRYPTION_KEY,
  // optional GOOGLE_OAUTH_REDIRECT_URI. See GOOGLE_CALENDAR_SETUP.md.
  "name": "rosetta-sales-dashboard",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["dist/server/**/*.js", "dist/server/**/*.mjs"]
    }
  ],
  "vars": {
    "PASSWORD_ACCESS_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rosetta-sales-dashboard",
      "database_id": "30f835c2-502c-48b0-a96a-2756d499c162",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
